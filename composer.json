{
  "name": "pixelpeter/laravel-genderize-api-client",
  "description": "Laravel 12+ client for the genderize.io API",
  "keywords": [
    "laravel",
    "api",
    "gender",
    "validation"
  ],
  "homepage": "https://github.com/pixelpeter/laravel-genderize-api-client",
  "license": "MIT",
  "authors": [
    {
      "name": "Peter Haak",
      "email": "info@pixelpeter.de",
      "homepage": "https://pixelpeter.de/",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3|^8.4|^8.5",
    "mashape/unirest-php": "^3.0.4",
    "laravel/framework": "^12.61.1|^13.0"
  },
  "autoload": {
    "psr-4": {
      "Pixelpeter\\Genderize\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pixelpeter\\Genderize\\Tests\\": "tests"
    }
  },
  "require-dev": {
    "mockery/mockery": "^1.6.12",
    "orchestra/testbench": "^10.0|^11.0",
    "php-coveralls/php-coveralls": "^2.7",
    "phpstan/extension-installer": "^1.3",
    "phpstan/phpstan": "^2.1.2",
    "phpunit/phpunit": "^12.5.8"
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pixelpeter\\Genderize\\GenderizeServiceProvider"
      ],
      "aliases": {
        "Genderize": "Pixelpeter\\Genderize\\Facades\\Genderize"
      }
    }
  }
}
